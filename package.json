{
  "name": "learn-to-juggle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "wrangler pages dev out",
    "deploy": "npm run build && wrangler pages deploy",
    "deploy-storybook": "npm run build-storybook && wrangler pages deploy storybook-static --branch storybook",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --disable-telemetry --no-open",
    "build-storybook": "storybook build --disable-telemetry",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/nextjs-vite": "10.6.8",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "1.65.1",
    "postcss": "^8",
    "storybook": "10.6.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.168.0"
  }
}
